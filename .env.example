# Chave da API da OpenAI (obrigatória) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Chave da API do Gamma (obrigatória para a Etapa 8/Slides) — plano Pro/Ultra/
# Team/Business, gerada em Settings > API Keys: https://gamma.app/
GAMMA_API_KEY=

# Porta do servidor (opcional; padrão 3000)
# PORT=3000

# Cadência do polling da geração de slides no Gamma (opcional; em ms).
# Existem para encurtar a espera na suíte de testes — não mexa em produção.
# GAMMA_POLL_INTERVAL_MS=5000
# GAMMA_POLL_TIMEOUT_MS=300000
