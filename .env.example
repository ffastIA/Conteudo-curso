# Chave da API da OpenAI (obrigatória) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo usado na pesquisa web da Etapa 2 (opcional; padrão gpt-4o). Precisa
# suportar a ferramenta web_search da Responses API — modelos *-search-preview
# foram descontinuados. O servidor avisa na inicialização se o valor for suspeito.
# OPENAI_RESEARCH_MODEL=gpt-4o

# Observabilidade das chamadas ao LLM com Langfuse AUTOHOSPEDADO (opcional).
# Desligada sem estas variáveis; se o Langfuse cair, a geração continua.
# Passo a passo: docs/langfuse-autohospedado.md (use a porta 3001 — a 3000 é do app).
# LANGFUSE_ENABLED=true
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# metadados (padrão): só tamanhos, tokens, custo e ids; completo: envia o texto (mascarado)
# LANGFUSE_CAPTURE=metadados
# Fração dos traces enviados (0 a 1); falhas e aulas incompletas são sempre enviadas
# LANGFUSE_SAMPLE_RATE=1

# Modelo do conteúdo das aulas — roteiro, seções e expansão (opcional; padrão gpt-4o-mini).
# OPENAI_CONTENT_MODEL=gpt-4o-mini
# Modelo das demais etapas (ementa, planos, avaliação, PPC, roteiros…). Padrão gpt-4o-mini.
# OPENAI_ECONOMY_MODEL=gpt-4o-mini
# Modo de geração do conteúdo: "secoes" (padrão: roteiro da aula + uma chamada por
# seção, com continuação em caso de corte) ou "unico" (legado: uma chamada por aula,
# também com continuação e verificação de completude).
# CONTEUDO_MODO=secoes

# Pesquisa por módulo (Etapa 5): por padrão a geração do conteúdo EXIGE a pesquisa por
# módulo concluída (ou a escolha explícita de gerar sem ela). "false" desliga a exigência.
# PESQUISA_MODULOS_OBRIGATORIA=true
# Pausa (ms) entre as pesquisas de módulos consecutivos (padrão 1500).
# PESQUISA_MODULOS_PAUSA_MS=1500

# Orçamento de tokens de ENTRADA por chamada de avaliação (revisão, juiz de score,
# relatório técnico e PPC). Cabendo, a avaliação usa o texto inteiro numa chamada;
# acima disso é dividida (map-reduce por seção) — nunca cortada. Padrão 24000.
# AVALIACAO_MAX_TOKENS_ENTRADA=24000

# Aulas geradas ao mesmo tempo na Etapa 5 (padrão 1 = sequencial; máximo 2). Com 2, o
# texto das aulas só aparece ao final (os tokens delas se misturariam). Ligue só se a
# conta tiver folga de tokens por minuto — um 429 faz o app esperar e repetir sozinho.
# CONTEUDO_PARALELISMO=1
# Espera adaptativa em 429: usa retry-after da API; sem ele, backoff de 2 s dobrando até 60 s.
# RATE_LIMIT_MAX_RETENTATIVAS=4
# RATE_LIMIT_BACKOFF_BASE_MS=2000
# RATE_LIMIT_ESPERA_MAX_MS=60000
# Downloads do .pptx (Gamma) e do .mp4 (HeyGen): timeout total e tamanho máximo.
# DOWNLOAD_TIMEOUT_MS=300000
# MAX_DOWNLOAD_BYTES=524288000

# Chave da API do Gamma (obrigatória para a Etapa 8/Slides) — plano Pro/Ultra/
# Team/Business, gerada em Settings > API Keys: https://gamma.app/
GAMMA_API_KEY=

# Lista opcional de IDs de templates customizados do Gamma (gammaId) a
# oferecer na Etapa 8. Quando definida, o usuário escolhe um template por
# curso e os slides são gerados preservando a estrutura/layout dessa
# apresentação (logo fixa etc.), em vez do estilo livre padrão. Sem ela, a
# Etapa 8 funciona exatamente como antes desta funcionalidade.
# Formato: IDs separados por vírgula (espaços em volta são ignorados).
# GAMMA_TEMPLATE_IDS=g_xxxxxxxxxxxx,g_yyyyyyyyyyyy
# Instrução opcional por template, enviada antes do conteúdo da aula (ex.: preservar a
# logo do template). JSON { "<templateId>": "instrução" } em uma linha; template sem
# entrada não recebe instrução fixa.
# GAMMA_TEMPLATE_PROMPTS={"g_xxxxxxxxxxxx":"Preserve a logo do template na mesma posição em todos os cards."}

# Chave da API do HeyGen (obrigatória para a Etapa 10/Vídeo com Avatar) —
# gerada em Settings > API: https://app.heygen.com/
HEYGEN_API_KEY=

# Listas opcionais de IDs de avatares/vozes do HeyGen a exibir na Etapa 10.
# Restringem a tela de seleção a um subconjunto curado do workspace — sem
# elas, todos os avatares/vozes do workspace aparecem (comportamento atual).
# Formato: IDs separados por vírgula (espaços em volta são ignorados).
# HEYGEN_AVATAR_IDS=avatar_id_1,avatar_id_2
# HEYGEN_VOICE_IDS=voice_id_1,voice_id_2

# Porta do servidor (opcional; padrão 3000)
# PORT=3000
# Endereço de bind. Padrão 127.0.0.1 (só esta máquina). Em container ou LAN use 0.0.0.0
# (o app não tem autenticação: exponha somente em rede confiável).
# HOST=127.0.0.1
# Rota /api/dev/seed (dados de exemplo) — só com true e fora de produção.
# ENABLE_DEV_SEED=false
# Limite de upload .docx em bytes (padrão 20 MB) e expiração de sessão inativa (padrão 12 h).
# UPLOAD_MAX_BYTES=20971520
# SESSAO_TTL_HORAS=12
# Logs JSON (debug | info | warn | error | silent; padrão info).
# LOG_LEVEL=info
# Orçamento por projeto em USD: aborta a etapa se custo acumulado + próxima chamada passar do teto.
# Desligado quando ausente. O disjuntor (só com orçamento) recusa chamadas após N falhas seguidas.
# ORCAMENTO_USD=5
# DISJUNTOR_FALHAS=5
# DISJUNTOR_ESPERA_MS=60000

# Arquivo onde o seletor de pasta lembra a última pasta escolhida (opcional;
# padrão: .ultima-pasta.json na raiz da aplicação).
# ULTIMA_PASTA_FILE=

# Cadência do polling da geração de slides no Gamma (opcional; em ms).
# Existem para encurtar a espera na suíte de testes — não mexa em produção.
# GAMMA_POLL_INTERVAL_MS=5000
# GAMMA_POLL_TIMEOUT_MS=300000

# Cadência do polling da geração de vídeo no HeyGen (opcional; em ms).
# Mesmo propósito das GAMMA_POLL_* acima — vídeo demora mais, teto padrão maior.
# HEYGEN_POLL_INTERVAL_MS=5000
# HEYGEN_POLL_TIMEOUT_MS=600000
# Saldo da carteira HeyGen (consumo do vídeo = saldo inicial − saldo final):
# HEYGEN_SALDO_ALERTA_USD=2          # aviso de saldo baixo na tela (não bloqueia a geração)
# HEYGEN_SALDO_TENTATIVAS=3          # leituras do saldo final se a cobrança ainda não apareceu
# HEYGEN_SALDO_ESPERA_MS=5000        # espera entre essas leituras
# HEYGEN_SALDO_INTERVALO_MS=3000     # no máximo uma leitura ao HeyGen por esse intervalo (tela e botão)

# === Deploy em múltiplas máquinas ============================================
#
# Este sistema suporta distribuição segura das chaves via .env.encrypted.
# O arquivo .env.encrypted pode ser commitado no git; a passphrase em .env.key
# é compartilhada uma única vez via canal seguro (1Password, WhatsApp, etc.).
#
# MÁQUINA PRINCIPAL (configuração inicial):
#   1. Preencha este arquivo e salve como .env
#   2. Execute: node scripts/env-crypto.js keygen   (gera .env.key)
#   3. Execute: npm run env:encrypt                  (gera .env.encrypted)
#   4. Commite: git add .env.encrypted && git commit -m "Adiciona env criptografado"
#   5. Compartilhe .env.key via canal seguro com os responsáveis das outras máquinas
#
# NOVA MÁQUINA:
#   1. git clone <repo> (ou git pull)
#   2. Coloque o .env.key recebido na raiz do projeto
#   3. node server.js   (descriptografa automaticamente no startup)
#
# OPERAÇÕES MANUAIS:
#   npm run env:encrypt   → recriptografa após alterar o .env
#   npm run env:decrypt   → imprime o .env atual na stdout (para conferência)
#
# SEGURANÇA:
#   - .env.key está no .gitignore — NUNCA commite manualmente
#   - Gire a passphrase rodando keygen + encrypt novamente se houver vazamento
